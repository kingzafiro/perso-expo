{
  "expo": {
    "name": "perso",
    "slug": "perso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "perso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.perso.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.perso.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F06808",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Perso necesita acceso a tus fotos para actualizar tu foto de perfil.",
          "cameraPermission": "Perso necesita acceso a tu cámara para tomar una nueva foto de perfil."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Perso usa tu ubicación para autocompletar tu dirección en el mapa y mostrarte vacantes cercanas."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Perso usa la cámara para escanear tus documentos oficiales con el encuadre adecuado."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F06808",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2c2ad66-1748-498a-ba28-cabd3acb630e"
      }
    },
    "owner": "kingzafiro"
  }
}
